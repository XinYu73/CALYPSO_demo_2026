.DS_Store

# Python/local runtime state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# CALYPSO local run products. Keep reference outputs tracked for comparison.
demo_2026/.local_run_state/
demo_2026/*/run/BackStage/
demo_2026/*/run/CALYPSO.logdir/
demo_2026/*/run/results/
demo_2026/*/run/results[0-9]*/

# Keep the compact archive in Git; the expanded database is many small files.
demo_2026/bulk_substitute_LaFeO3/MP_EXP_Database/experimental/

# Scheduler/local job logs from fresh runs
demo_2026/*/run/job.*.out
demo_2026/*/run/job.*.err
demo_2026/*/run/*.log

# Temporary scratch files
*.tmp
*.swp
*~
temp